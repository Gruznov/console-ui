{
  "name": "@polyconsole/console-ui",
  "version": "0.7.0",
  "description": "Product-neutral React foundations for shared internal consoles",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gruznov/console-ui.git",
    "directory": "packages/console-ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@polyconsole/design-tokens": "0.2.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0"
  }
}
